{
  "name": "@local/composer-notes",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Save one-shot notes in the composer and insert them into the message input.",
  "author": "toosean",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/toosean/dsh-composer-notes.git"
  },
  "homepage": "https://github.com/toosean/dsh-composer-notes#readme",
  "bugs": {
    "url": "https://github.com/toosean/dsh-composer-notes/issues"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "composer",
    "notes"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "peerDependencies": {
    "@deepseek-ai/schemastery": "~3.19.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
